/* Copyright 2026 Rhett Creighton - Apache License 2.0
 *
 * HOST NEEDS — the one place a registered test group declares the input its
 * host must already carry for the group to observe anything.
 *
 * These rows exist because a proof generation is a deliberately narrow tree:
 * it never builds the node runtime binaries, and it carries none of an
 * operator's multi-gigabyte fixtures. A group whose only honest verdict in
 * such a tree is SKIP or UNOBSERVED must be left OUT of the universal
 * closure selector, so the runner counts it as gated instead of forcing the
 * whole proof to refuse on `test_accounting_incomplete`.
 *
 * This is a SELECTION rule and nothing else:
 *   - the group still runs everywhere its input exists (a dev box with
 *     build/bin/z23, an operator with the fold fixture exported);
 *   - an exact impact plan that names the group still selects it, and a SKIP
 *     or UNOBSERVED there still refuses the proof;
 *   - every gated group is NAMED in the attempt test-selection log, so
 *     nothing is quietly dropped.
 *
 * Include with ZCL_TEST_GROUP_NEED(full_id, kind, value):
 *   ZCL_HOST_NEED_FILE  value is a path relative to the tree the runner execs
 *                       in; the need is met when that path exists there.
 *   ZCL_HOST_NEED_ENV   value is an environment variable name; the need is
 *                       met when it is set to a non-empty string.
 * The id is the canonical full catalog id (`test_`/`spec_` prefix included),
 * exactly as zcl_test_group_catalog_at() spells it. An unregistered group or
 * an unknown kind is a refusal, never a silently ignored row.
 *
 * ZCL_TEST_GROUP_BUILD_NEED(full_id, value, target) declares the other shape:
 * an optional tool no default build reaches, which the proof builds itself.
 * `value` is the path the group execs, relative to the tree, and `target`
 * the Make target that builds it from that tree's own sources. A proof whose
 * selection carries the group runs `make target` in its generation before
 * the test dimension, binds the built bytes into the test receipt, and fails
 * by name (test_need_unbuildable_<target>) when the build cannot produce
 * `value`. The group is never gated out and never left to self-skip; a
 * proof that selects no such group builds nothing extra. A need the proof
 * already provides -- a path it admits content-checked
 * (build/bin/zclassic23) or a target its prefork step always builds (fbsh)
 * -- is left as provided rather than rebuilt. Local `make t`, `make t-fast`,
 * `make t-fast-exact` and `make test-parallel` read the same rows through
 * `test_parallel --list-build-needs` and build exactly the targets their own
 * selection needs before the run, failing by the same name.
 * A group may declare several BUILD rows with distinct targets; it declares
 * at most one FILE or ENV row and never mixes the two shapes.
 */

/* tests/harness/src/test_onion_pair_watch_live.c reports
 * PAIR_PROBE=ENV_MISSING_BINARY (UNOBSERVED) when the tree it runs in has no
 * z23/zclassic23/zcl-rpc runtime binary to pair. A proof generation never
 * builds those, by design. */
ZCL_TEST_GROUP_NEED("test_onion_pair_watch_live",
                    ZCL_HOST_NEED_FILE, "build/bin/z23")

/* tests/harness/src/test_self_folded_anchor.c's heavy leg prints SKIP unless
 * ZCL_SELF_FOLD_ANCHOR_FIXTURE names a real `-mint-anchor` artifact. Nothing
 * inside a proof can produce one; it is provisioned by an operator. */
ZCL_TEST_GROUP_NEED("test_self_folded_anchor_heavy", ZCL_HOST_NEED_ENV,
                    "ZCL_SELF_FOLD_ANCHOR_FIXTURE")

/* tests/harness/src/test_semantic_manifest.c (group semantic_sensor),
 * test_semantic_facts_live.c, test_semantic_consumer_live.c and
 * test_semantic_facts_fuzz.c exec the optional libclang sensor
 * build/bin/z23-clang-manifest and self-skip where it is absent. It links
 * libclang, so no default target builds it; a proof that selects any of the
 * four builds `make clang-manifest` in its generation. */
ZCL_TEST_GROUP_BUILD_NEED("test_semantic_sensor",
                          "build/bin/z23-clang-manifest", "clang-manifest")
ZCL_TEST_GROUP_BUILD_NEED("test_semantic_facts_live",
                          "build/bin/z23-clang-manifest", "clang-manifest")
ZCL_TEST_GROUP_BUILD_NEED("test_semantic_consumer_live",
                          "build/bin/z23-clang-manifest", "clang-manifest")
ZCL_TEST_GROUP_BUILD_NEED("test_semantic_facts_fuzz",
                          "build/bin/z23-clang-manifest", "clang-manifest")

/* tests/harness/src/test_fleet_gateway.c: every shard spawns the gateway
 * build/bin/z23-fleet-gateway, which fork/execs the node by its
 * compatibility name build/bin/zclassic23 for each tool call. Neither is a
 * default test prerequisite, and a shard without them can only fail. A proof
 * generation admits the dev node at build/bin/zclassic23, content-checked,
 * so the proof's test-needs step leaves it alone and builds only the
 * gateway; a local run builds both. The base group fleet_gateway only checks
 * the shard partition and needs neither. */
#define ZCL_FLEET_GATEWAY_SHARD_NEEDS(id_)                                   \
    ZCL_TEST_GROUP_BUILD_NEED(id_, "build/bin/z23-fleet-gateway",            \
                              "fleet-gateway")                               \
    ZCL_TEST_GROUP_BUILD_NEED(id_, "build/bin/zclassic23", "zclassic23")
ZCL_FLEET_GATEWAY_SHARD_NEEDS("test_fleet_gateway_shard_01")
ZCL_FLEET_GATEWAY_SHARD_NEEDS("test_fleet_gateway_shard_02")
ZCL_FLEET_GATEWAY_SHARD_NEEDS("test_fleet_gateway_shard_03")
ZCL_FLEET_GATEWAY_SHARD_NEEDS("test_fleet_gateway_shard_04")
ZCL_FLEET_GATEWAY_SHARD_NEEDS("test_fleet_gateway_shard_05")
ZCL_FLEET_GATEWAY_SHARD_NEEDS("test_fleet_gateway_shard_06")
#undef ZCL_FLEET_GATEWAY_SHARD_NEEDS

/* These exec the node by its compatibility name build/bin/zclassic23 (the
 * `z23` product symlinked by `make zclassic23`) and self-skip where it is
 * absent. A proof generation admits the dev node at that path, so only a
 * local run builds it. */
ZCL_TEST_GROUP_BUILD_NEED("test_cli_auth_robust", "build/bin/zclassic23",
                          "zclassic23")
ZCL_TEST_GROUP_BUILD_NEED("test_cli_argv_strict", "build/bin/zclassic23",
                          "zclassic23")
ZCL_TEST_GROUP_BUILD_NEED("test_importblockindex_cli_dispatch",
                          "build/bin/zclassic23", "zclassic23")

/* tests/harness/src/test_freebsd_sh.c execs build/bin/fbsh and self-skips
 * where it is absent. The proof's prefork step builds fbsh for every test
 * selection, so only a local run needs this row. */
ZCL_TEST_GROUP_BUILD_NEED("test_freebsd_sh", "build/bin/fbsh", "fbsh")

/* tests/harness/src/test_consensus_rule_sweep.c's "exec the standalone tool"
 * arm execs build/bin/consensus_rule_sweep and reports that arm NOT RUN,
 * not a group failure, where the tool is absent or stale (the other arms
 * still run in-process). No default target builds it; a proof that selects
 * this group builds it in its generation. */
ZCL_TEST_GROUP_BUILD_NEED("test_consensus_rule_sweep",
                          "build/bin/consensus_rule_sweep",
                          "tools/consensus_rule_sweep")
